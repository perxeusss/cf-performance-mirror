{
  "manifest_version": 3,
  "name": "CF Performance Mirror",
  "description": "Analyze your Codeforces performance with solve-time stats, WA% insights, time-slot tracking, and smart division detection — all in one extension.",
  "version": "1.0.7",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.codeforces.com/profile/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://*.codeforces.com/*"
  ],
  "permissions": [],
  "browser_specific_settings": {
    "gecko": {
      "id": "cfmirror@perxeusss",
      "strict_min_version": "140.0"
    }
  }
}
