{
  "manifest_version": 2,
  "name": "CF Performance Mirror",
  "short_name": "CF Mirror",
  "description": "CF Performance Mirror shows your avg/median solve time, WA% by topic and individual problems — all filtered by division and time range, right on the profile page.",
  "version": "1.0.24",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": [
        "https://codeforces.com/profile/*",
        "https://*.codeforces.com/profile/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "permissions": [
    "https://codeforces.com/*",
    "https://*.codeforces.com/*"
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "cf-performance-mirror@yourdomain.com",
      "strict_min_version": "57.0"
    }
  }
}